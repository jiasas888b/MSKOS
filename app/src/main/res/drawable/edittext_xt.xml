<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 设置背景填充色为白色 -->
    <solid android:color="#FFFFFF" />
    
    <!-- 设置边框：宽度1dp，浅灰色 -->
    <stroke 
        android:width="1dp" 
        android:color="#D3D3D3" />
    
    <!-- 可选：添加一点圆角，让边框更柔和 -->
    <corners android:radius="4dp" />
    
    <!-- 可选：添加内边距，让文本不贴边 -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>